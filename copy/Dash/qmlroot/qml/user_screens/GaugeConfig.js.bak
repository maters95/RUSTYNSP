function initGauge(gauge,id){
  var i;
  for(i=0; i < GaugeParams.length; i++){
      var cg = GaugeParams[i];
      if(cg.id == id){
          for(var k in cg){
              if (gauge.hasOwnProperty(k)) gauge[k] = cg[k];
          }
          initColorPalette(gauge, cg.qmlFile, cg.gaugeType);
          return;
      }
  }
}
