<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NSP</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <Target Name="RequireFormResources" BeforeTargets="PrepareForBuild"
          Condition="'$(EnableDefaultEmbeddedResourceItems)' == 'false'">
    <Error Text="NSP requires its form resources. Remove EnableDefaultEmbeddedResourceItems=false from the build command." />
  </Target>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../ic7-custom-dash/deploy/nsp/HalImage.qml"
                      LogicalName="NSP.Media.HalImage.qml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.ServiceModel.Primitives">
      <HintPath>../vendor/local-installs/haltech-nsp/System.ServiceModel.Primitives.dll</HintPath>
    </Reference>
    <Reference Include="FTDI2XX">
      <HintPath>../vendor/local-installs/haltech-nsp/FTDI2XX.dll</HintPath>
    </Reference>
    <Reference Include="System.IO.Ports">
