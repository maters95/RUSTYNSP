    </Reference>
    <Reference Include="System.Configuration.ConfigurationManager">
      <HintPath>../vendor/local-installs/haltech-nsp/System.Configuration.ConfigurationManager.dll</HintPath>
    </Reference>
    <Reference Include="System.Drawing.Common">
      <HintPath>../vendor/local-installs/haltech-nsp/System.Drawing.Common.dll</HintPath>
    </Reference>
    <Reference Include="Ionic.Zip">
      <HintPath>../vendor/local-installs/haltech-nsp/Ionic.Zip.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms.Primitives">
      <HintPath>../vendor/local-installs/haltech-nsp/System.Windows.Forms.Primitives.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
